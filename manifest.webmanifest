{
  "name": "Caja Chica · Telconsulting",
  "short_name": "Caja Chica",
  "description": "Escanea boletas y facturas de la caja chica Mercado Pago, respáldalas en Drive y regístralas en la planilla.",
  "lang": "es-CL",
  "id": "./",
  "start_url": "./?origen=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12181f",
  "theme_color": "#12181f",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Escanear documento",
      "short_name": "Escanear",
      "url": "./?accion=escanear",
      "icons": [{ "src": "icons/atajo-escanear-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "archivos", "accept": ["image/*", "application/pdf", ".pdf", ".jpg", ".jpeg", ".png"] }]
    }
  }
}
